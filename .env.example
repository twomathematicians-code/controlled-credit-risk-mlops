# Copy to `.env` and adjust. All values are optional — config.yaml is the
# primary source of truth and these variables override it where relevant.

# MLflow tracking. Local sqlite by default; point at a remote tracker for Azure.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_REGISTRY_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=credit_risk_pd
MLFLOW_REGISTRY_MODEL_NAME=credit_risk_pd_model

# Serving
SERVING_HOST=0.0.0.0
SERVING_PORT=8000
SERVING_MODEL_STAGE=Production

# Azure (only needed for deployment/azure scripts, not for local runs)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=
AZURE_STORAGE_ACCOUNT=
